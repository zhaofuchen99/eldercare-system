# =====================================================================
# 环境变量示例：复制为 .env 后按需修改
#   cp .env.example .env
# =====================================================================

# ===== 必填：安全密钥（部署前务必改为随机强密码）=====
MYSQL_ROOT_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-32-char-random-secret
REPORT_DOWNLOAD_SECRET=change-me-another-random-secret

# ===== AI（可选）=====
# 不填则应用可启动，但 AI 对话/评分降级（消息打 FAILED）。
# 生产建议在 DeepSeek 官网申请 key 后填入。
DEEPSEEK_API_KEY=

# ===== 镜像与端口（一般用默认）=====
# MySQL 镜像 tag；若 mysql:9.7 拉取失败可改 mysql:9 或 mysql:8.4（表结构兼容）
MYSQL_IMAGE=mysql:9.7
# 会员端对外端口
MEMBER_PORT=80
# 管理端对外端口
ADMIN_PORT=8081
